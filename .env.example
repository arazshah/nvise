DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://nvise:nvise@db:5432/nvise
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Bale bot integration
BALE_BOT_TOKEN=
BALE_BOT_ID=primary
BALE_WEBHOOK_SECRET=change-this-to-a-long-random-value

# Private attachment storage
PRIVATE_MEDIA_ROOT=/app/private_media
MAX_PROVIDER_FILE_BYTES=20971520

# Speech-to-text provider
STT_PROVIDER=http
STT_HTTP_ENDPOINT=
STT_API_KEY=
STT_TIMEOUT_SECONDS=120

# Structured AI extraction provider
AI_EXTRACTION_PROVIDER=http
AI_EXTRACTION_ENDPOINT=
AI_EXTRACTION_API_KEY=
AI_EXTRACTION_TIMEOUT_SECONDS=120
