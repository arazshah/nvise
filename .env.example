DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Production PostgreSQL container credentials (docker-compose.prod.yml)
POSTGRES_DB=nvise
POSTGRES_USER=nvise
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://nvise:change-me@db:5432/nvise

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=270

# Public web portal
WEB_BASE_URL=http://localhost:8000
REVIEW_LINK_TTL_MINUTES=15
PORTAL_LINK_TTL_MINUTES=2

# Bale bot integration
BALE_BOT_TOKEN=
BALE_BOT_ID=primary
BALE_WEBHOOK_SECRET=change-this-to-a-long-random-value
BALE_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
MAX_WEBHOOK_BODY_BYTES=1048576

# Private attachment/document storage
PRIVATE_MEDIA_ROOT=/app/private_media
MAX_PROVIDER_FILE_BYTES=20971520

# Speech-to-text provider
STT_PROVIDER=http
STT_HTTP_ENDPOINT=
STT_API_KEY=
STT_TIMEOUT_SECONDS=120

# Structured AI extraction provider
AI_EXTRACTION_PROVIDER=http
AI_EXTRACTION_ENDPOINT=
AI_EXTRACTION_API_KEY=
AI_EXTRACTION_TIMEOUT_SECONDS=120
